{
  "name": "my-device-view",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/prepare-sites-build.mjs",
    "build:pages": "expo export --platform web --output-dir dist && GITHUB_PAGES_BASE_PATH=remote-elevator-demo node scripts/prepare-github-pages.mjs",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~5.9.2"
  }
}
