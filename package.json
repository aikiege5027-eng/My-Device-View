{
  "name": "my-device-view",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist && node scripts/prepare-sites-build.mjs",
    "build:pages": "expo export --platform web --output-dir dist && GITHUB_PAGES_BASE_PATH=My-Device-View node scripts/prepare-github-pages.mjs",
    "build:design-system": "pnpm --filter @kone/mobile-design-system build",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "verify:design-system-peers": "node scripts/verify-design-system-peers.mjs"
  },
  "dependencies": {
    "@kone/mobile-design-system": "workspace:0.1.0",
    "@expo/metro-runtime": "~6.1.2",
    "expo": "~54.0.0",
    "expo-status-bar": "~3.0.8",
    "html2canvas": "1.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.11",
    "babel-preset-expo": "~54.0.0",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~5.9.2"
  }
}
